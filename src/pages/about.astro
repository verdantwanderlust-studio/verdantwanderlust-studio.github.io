---
import Base from '~/layouts/Base.astro';
import { getEntry } from 'astro:content';

const { data } = await getEntry('pages', 'about');
---
<Base title="About · 景觀丸藝" description="關於景觀丸藝。">
  <article class="column page">
    <p class="kicker">{data.kicker}</p>
    <h1>{data.title}</h1>
    <p class="lede">{data.lede}</p>

    <div class="body">
      {data.body?.map((para) => <p>{para}</p>)}
    </div>
  </article>
</Base>

<style>
  .page {
    padding: var(--s-16) 0 var(--s-24);
    max-width: 720px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: var(--track-tight);
    line-height: var(--lh-tight);
    margin: var(--s-3) 0 var(--s-8) 0;
  }
  .body {
    margin-top: var(--s-12);
    line-height: 1.85;
    color: var(--ink);
  }
  .body p {
    margin: 0 0 var(--s-6) 0;
  }
</style>
