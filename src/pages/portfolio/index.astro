---
import Base from '~/layouts/Base.astro';
import { Image } from 'astro:assets';

import img01 from '~/assets/portfolio/01-terrarium-vw.jpg';
import img02 from '~/assets/portfolio/02.jpg';
import img03 from '~/assets/portfolio/03.jpg';
import img04 from '~/assets/portfolio/04.jpg';
import img05 from '~/assets/portfolio/05.jpg';
import img06 from '~/assets/portfolio/06.jpg';
import img07 from '~/assets/portfolio/07-lion-king.png';
import img08 from '~/assets/portfolio/08-lion-king.png';
import img09 from '~/assets/portfolio/09-lion-king.png';

const works = [
  { img: img01, title: '_作品 01_', size: '_尺寸_', concept: '_作品理念待 Ivy 填寫_', year: 2024, loc: '_系列_' },
  { img: img02, title: '_作品 02_', size: '_尺寸_', concept: '_作品理念待 Ivy 填寫_', year: 2024, loc: '_系列_' },
  { img: img03, title: '_作品 03_', size: '_尺寸_', concept: '_作品理念待 Ivy 填寫_', year: 2024, loc: '_系列_' },
  { img: img04, title: '_作品 04_', size: '_尺寸_', concept: '_作品理念待 Ivy 填寫_', year: 2024, loc: '_系列_' },
  { img: img05, title: '_作品 05_', size: '_尺寸_', concept: '_作品理念待 Ivy 填寫_', year: 2024, loc: '_系列_' },
  { img: img06, title: '_作品 06_', size: '_尺寸_', concept: '_作品理念待 Ivy 填寫_', year: 2024, loc: '_系列_' },
  { img: img07, title: 'The Lion King I', size: '_尺寸_', concept: '_系列作品_', year: 2024, loc: 'Lion King 系列' },
  { img: img08, title: 'The Lion King III', size: '_尺寸_', concept: '_系列作品_', year: 2024, loc: 'Lion King 系列' },
  { img: img09, title: 'The Lion King IV', size: '_尺寸_', concept: '_系列作品_', year: 2024, loc: 'Lion King 系列' },
];
---
<Base
  title="Portfolio · 景觀丸藝"
  description="作品集 — 景觀丸藝近期案場。"
>
  <div class="portfolio-page">
    <header class="port-header">
      <div class="column">
        <p class="kicker">作品集 / Portfolio</p>
      </div>
    </header>

    <section class="grid-section">
      <div class="column">
        <ul class="grid">
          {works.map((w, i) => (
            <li
              class="card"
              role="button"
              tabindex="0"
              data-index={i}
              data-title={w.title}
              data-size={w.size}
              data-concept={w.concept}
              data-year={w.year}
              data-loc={w.loc}
            >
              <div class="flipper">
                <div class="face front" aria-hidden="false">
                  <Image
                    src={w.img}
                    alt={w.title}
                    width={600}
                    height={600}
                    densities={[1, 2]}
                    loading="lazy"
                    class="thumb-img"
                  />
                </div>
                <div class="face back">
                  <div class="back-meta">{w.loc} · {w.year}</div>
                  <h3 class="back-title">{w.title}</h3>
                  <dl class="back-dl">
                    <dt>尺寸</dt><dd>{w.size}</dd>
                    <dt>理念</dt><dd>{w.concept}</dd>
                  </dl>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <!-- Modal -->
  <div id="port-modal" class="modal" role="dialog" aria-modal="true" aria-label="作品詳情" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-box">
      <button class="modal-close" aria-label="關閉">✕</button>
      <div class="modal-inner">
        <div class="modal-img-wrap">
          <img id="modal-img" src="" alt="" class="modal-img" />
        </div>
        <div class="modal-info">
          <p id="modal-meta" class="modal-meta"></p>
          <h2 id="modal-title" class="modal-title"></h2>
          <dl class="modal-dl">
            <dt>尺寸</dt><dd id="modal-size"></dd>
            <dt>理念</dt><dd id="modal-concept"></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .portfolio-page { background: var(--bg); min-height: 100vh; }

  .port-header {
    padding: var(--s-8) 0 var(--s-6);
    border-bottom: 1px solid var(--border);
  }
  .port-header .kicker {
    margin: 0;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: var(--track-tight);
    line-height: var(--lh-tight);
    text-transform: none;
  }

  .grid-section { padding: var(--s-12) 0 var(--s-24); }
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .card {
    perspective: 1200px;
    aspect-ratio: 1 / 1;
    cursor: pointer;
  }

  .flipper {
    position: relative;
    width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform 600ms var(--ease);
  }
  .card:hover .flipper,
  .card:focus-within .flipper {
    transform: rotateY(180deg);
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 0;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .front { background: var(--surface); }
  .thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .back {
    background: var(--surface);
    transform: rotateY(180deg);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .back-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--subtle);
    margin-bottom: var(--s-2);
  }
  .back-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-lg);
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 var(--s-4) 0;
  }
  .back-dl {
    margin: 0;
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--s-2) var(--s-3);
    font-size: var(--t-sm);
  }
  .back-dl dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--subtle);
    padding-top: 3px;
  }
  .back-dl dd { margin: 0; color: var(--ink); line-height: 1.5; }

  /* ---- Modal ---- */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal[hidden] { display: none; }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .modal-box {
    position: relative;
    z-index: 1;
    background: var(--surface);
    border-radius: var(--r-lg);
    width: min(920px, 92vw);
    max-height: 88vh;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .modal-close {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
    z-index: 2;
    background: var(--surface-alt);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--ink);
    cursor: pointer;
    transition: background 200ms var(--ease);
  }
  .modal-close:hover { background: var(--border); }

  .modal-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 480px;
  }

  .modal-img-wrap {
    background: var(--surface-alt);
    border-right: 1px solid var(--border);
    overflow: hidden;
  }
  .modal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .modal-info {
    padding: var(--s-12) var(--s-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }

  .modal-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--subtle);
    margin: 0 0 var(--s-3) 0;
  }
  .modal-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-2xl);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 var(--s-8) 0;
    line-height: 1.15;
  }
  .modal-dl {
    margin: 0;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--s-3) var(--s-4);
  }
  .modal-dl dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--subtle);
    padding-top: 3px;
  }
  .modal-dl dd { margin: 0; color: var(--ink); line-height: 1.65; }

  @media (max-width: 720px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: 0; }
    .modal-inner { grid-template-columns: 1fr; }
    .modal-img-wrap { height: 240px; border-right: none; border-bottom: 1px solid var(--border); }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flipper { transition: none; }
  }
</style>

<script>
  const modal = document.getElementById('port-modal') as HTMLElement;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalMeta = document.getElementById('modal-meta') as HTMLElement;
  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const modalSize = document.getElementById('modal-size') as HTMLElement;
  const modalConcept = document.getElementById('modal-concept') as HTMLElement;
  const backdrop = modal.querySelector('.modal-backdrop') as HTMLElement;
  const closeBtn = modal.querySelector('.modal-close') as HTMLElement;

  function openModal(card: HTMLElement) {
    const thumb = card.querySelector<HTMLImageElement>('.thumb-img');
    modalImg.src = thumb?.currentSrc || thumb?.src || '';
    modalImg.alt = card.dataset.title || '';
    modalMeta.textContent = `${card.dataset.loc} · ${card.dataset.year}`;
    modalTitle.textContent = card.dataset.title || '';
    modalSize.textContent = card.dataset.size || '';
    modalConcept.textContent = card.dataset.concept || '';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.card').forEach(card => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(card);
      }
    });
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
</script>
