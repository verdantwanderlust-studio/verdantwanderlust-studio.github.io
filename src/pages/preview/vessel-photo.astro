---
/* /preview/vessel-photo — 實物照片拆解原型(throwaway 實驗頁)
   路線:設計團隊推薦的「照片分層」— Ivy 的作品照經 GPT Image 拆解 +
   洋紅色鍵去背,得到玻璃/沉木與主植/苔蘚/介質四張透明分層,
   GSAP scrub 在 CSS 3D 透視空間裡組裝↔拆解。不用 WebGL。
   對照組:/preview/vessel(程式化 Three.js 圖鑑風)。 */
import { Image } from 'astro:assets';
import glassImg from '~/assets/preview3d/glass.png';
import floraImg from '~/assets/preview3d/flora.png';
import mossImg from '~/assets/preview3d/moss.png';
import substrateImg from '~/assets/preview3d/substrate.png';
import realPhoto from '~/assets/portfolio/01-terrarium-vw.jpg';

/* 分層在 2048 高原始拆解圖上的座標(_keyslice.mjs manifest) */
const SHEET_H = 2048;
const layers = [
  { img: glassImg,     key: 'glass',     top: 21,   h: 655, z: 4, dy: 0.428,  ds: 1.0 },
  { img: floraImg,     key: 'flora',     top: 686,  h: 847, z: 3, dy: 0.0485, ds: 0.65 },
  { img: mossImg,      key: 'moss',      top: 1585, h: 197, z: 2, dy: -0.137, ds: 0.85 },
  { img: substrateImg, key: 'substrate', top: 1813, h: 193, z: 1, dy: -0.217, ds: 0.8 },
];
const labels = [
  { cy: 0.17,  side: 'r', zh: '玻璃容器', en: 'Glass Vessel', desc: '封住濕度循環的圓柱玻璃。' },
  { cy: 0.42,  side: 'l', zh: '沉木',     en: 'Driftwood',    desc: '地景的骨架,枝態決定山勢。' },
  { cy: 0.63,  side: 'r', zh: '主植',     en: 'Planting',     desc: '斑葉蘭與細葉蕨群,瓶中森林的主角。' },
  { cy: 0.822, side: 'l', zh: '苔蘚地被', en: 'Moss',         desc: '鎖住濕度的綠色地表。' },
  { cy: 0.932, side: 'r', zh: '介質基底', en: 'Substrate',    desc: '培養土與排水介質,一切從這裡開始。' },
];
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>實物拆解 — 景觀丸藝 / Verdant Wanderlust</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Serif+TC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
  />
</head>
<body>

  <!-- 1 · 拆解舞台(pin + scrub,純 CSS 3D) -->
  <section class="stage" id="stage">
    <header class="hero-copy" id="heroCopy">
      <p class="kicker">景觀丸藝 · Verdant Wanderlust</p>
      <h1>同一座瓶,<br />實物拆解</h1>
      <p class="lede">作品照片經 AI 分層還原:玻璃、沉木、主植、苔蘚、介質,逐層攤開。</p>
    </header>

    <div class="scene">
      <div class="stack" id="stack">
        {layers.map((l) => (
          <Image
            src={l.img}
            alt=""
            width={1100}
            densities={[1, 2]}
            loading="eager"
            class="layer"
            data-key={l.key}
            data-dy={l.dy}
            data-ds={l.ds}
            style={`top:${(l.top / SHEET_H) * 100}%; z-index:${l.z};`}
          />
        ))}
        {labels.map((lb) => (
          <div class={`layer-label side-${lb.side}`} style={`top:${lb.cy * 100}%;`}>
            <p class="ll-head"><span class="ll-zh">{lb.zh}</span><span class="ll-en">{lb.en}</span></p>
            <p class="ll-desc">{lb.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2 · 原圖對照 -->
  <section class="real">
    <div class="real-inner">
      <figure class="real-figure" id="realFigure">
        <Image src={realPhoto} alt="景觀丸藝的生態瓶原作照片" width={1400} densities={[1, 2]} class="real-img" />
      </figure>
      <div class="real-text">
        <h2>它原本的樣子</h2>
        <p>
          上面每一層,都是從這張作品照拆出來的。沒有建模,
          沒有另外打光,玻璃裡的世界本來就長這樣。
        </p>
      </div>
    </div>
  </section>

  <!-- 3 · 去處 -->
  <section class="next">
    <a class="next-link" href="/preview/vessel">
      <span class="zh">另一版:圖鑑式 3D</span>
      <span class="en">Schematic 3D</span>
    </a>
    <a class="next-link" href="/preview/portfolio">
      <span class="zh">看作品集</span>
      <span class="en">Portfolio</span>
    </a>
  </section>

  <footer class="foot">
    <a href="/preview/">回草稿首頁</a>
    <p>© 景觀丸藝 Verdant Wanderlust</p>
  </footer>

<style>
  :global(:root) {
    --v-bg: #10140f;
    --v-bg-deep: #0b0e0a;
    --v-ink: #e8e3d5;
    --v-faint: rgba(232, 227, 213, 0.62);
    --v-hairline: rgba(232, 227, 213, 0.16);
    --v-moss: #8fae84;
    --v-serif-en: 'Cormorant Garamond', serif;
    --v-serif-zh: 'Noto Serif TC', serif;
    --v-mono: 'JetBrains Mono', monospace;
    --v-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  :global(html) { background: var(--v-bg); }
  :global(body) {
    margin: 0;
    background: var(--v-bg);
    color: var(--v-ink);
    font-family: var(--v-serif-zh), var(--v-serif-en), serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }

  /* ---- 舞台 ---- */
  .stage { position: relative; min-height: 100dvh; overflow: hidden; }
  .hero-copy {
    position: absolute;
    top: clamp(24px, 6vh, 64px);
    left: clamp(20px, 6vw, 88px);
    max-width: 30rem;
    z-index: 6;
    pointer-events: none;
  }
  .kicker {
    font-family: var(--v-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--v-faint);
    margin: 0 0 1.1rem;
  }
  .hero-copy h1 {
    font-family: var(--v-serif-zh);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.2vw, 3.9rem);
    line-height: 1.18;
    letter-spacing: 0.04em;
    margin: 0 0 1.1rem;
  }
  .lede {
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.9;
    color: var(--v-faint);
    margin: 0;
    max-width: 26rem;
  }

  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1400px;
  }
  .stack {
    position: relative;
    height: min(88dvh, calc(92vw * 2048 / 1360));
    aspect-ratio: 1360 / 2048;
    transform-style: preserve-3d;
  }
  :global(.layer) {
    position: absolute;
    left: 0;
    width: 100%;
    height: auto;
    will-change: transform;
  }

  /* ---- 標籤 ---- */
  .layer-label {
    position: absolute;
    width: clamp(170px, 22vw, 260px);
    opacity: 0;
    z-index: 5;
    pointer-events: none;
  }
  .layer-label.side-r { left: calc(100% + clamp(16px, 3vw, 44px)); border-left: 1px solid var(--v-hairline); padding-left: 14px; }
  .layer-label.side-l { right: calc(100% + clamp(16px, 3vw, 44px)); border-right: 1px solid var(--v-hairline); padding-right: 14px; text-align: right; }
  .ll-head { display: flex; align-items: baseline; gap: 0.6em; margin: 0 0 0.35rem; }
  .side-l .ll-head { justify-content: flex-end; }
  .ll-zh { font-family: var(--v-serif-zh); font-weight: 500; font-size: 1.02rem; letter-spacing: 0.06em; }
  .ll-en { font-family: var(--v-serif-en); font-style: italic; font-size: 0.92rem; color: var(--v-moss); }
  .ll-desc { margin: 0; font-size: 0.8rem; line-height: 1.75; color: var(--v-faint); }

  /* ---- 原圖對照 ---- */
  .real { padding: clamp(96px, 16vh, 180px) clamp(20px, 6vw, 88px); background: var(--v-bg-deep); }
  .real-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }
  .real-figure { margin: 0; }
  :global(.real-img) { width: 100%; height: auto; display: block; border-radius: 2px; }
  .real-text h2 {
    font-family: var(--v-serif-zh);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    letter-spacing: 0.05em;
    line-height: 1.4;
    margin: 0 0 1.4rem;
  }
  .real-text p { font-size: 0.95rem; line-height: 2.05; color: var(--v-faint); margin: 0 0 1.2rem; max-width: 34ch; }

  /* ---- 去處 / footer ---- */
  .next { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--v-hairline); }
  .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: clamp(56px, 10vh, 110px) 24px;
    text-decoration: none;
    color: var(--v-ink);
    transition: background-color 240ms var(--v-ease-out);
  }
  .next-link + .next-link { border-left: 1px solid var(--v-hairline); }
  .next-link .zh { font-family: var(--v-serif-zh); font-weight: 400; font-size: clamp(1.4rem, 2.4vw, 2rem); letter-spacing: 0.1em; }
  .next-link .en { font-family: var(--v-serif-en); font-style: italic; font-size: 1rem; color: var(--v-moss); }
  @media (hover: hover) and (pointer: fine) {
    .next-link:hover { background: rgba(232, 227, 213, 0.04); }
  }
  .next-link:active { transform: scale(0.99); }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 28px clamp(20px, 6vw, 88px);
    border-top: 1px solid var(--v-hairline);
  }
  .foot a { color: var(--v-faint); text-decoration: none; font-size: 0.82rem; letter-spacing: 0.08em; }
  .foot a:hover { color: var(--v-ink); }
  .foot p { margin: 0; font-family: var(--v-serif-en); font-style: italic; font-size: 0.85rem; color: var(--v-faint); }

  @media (max-width: 900px) {
    .stack { height: min(72dvh, calc(92vw * 2048 / 1360)); }
    .layer-label { width: 150px; }
    .ll-desc { display: none; }
  }
  @media (max-width: 600px) {
    .layer-label { display: none; }
  }
  @media (max-width: 760px) {
    .real-inner { grid-template-columns: 1fr; align-items: start; }
    .next { grid-template-columns: 1fr; }
    .next-link + .next-link { border-left: 0; border-top: 1px solid var(--v-hairline); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stack = document.getElementById('stack') as HTMLElement;
  const heroCopy = document.getElementById('heroCopy') as HTMLElement;
  const layerEls = Array.from(stack.querySelectorAll<HTMLElement>('.layer'));
  const labelEls = Array.from(stack.querySelectorAll<HTMLElement>('.layer-label'));

  if (reduced) {
    /* 靜態拆解圖,標籤全顯示 */
    labelEls.forEach((el) => (el.style.opacity = '1'));
  } else {
    /* 初始 = 組裝態(各層往瓶位收攏),scrub 到 0 = 攤開成拆解圖 */
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#stage',
        start: 'top top',
        end: '+=280%',
        pin: true,
        scrub: 0.6,
        invalidateOnRefresh: true,
      },
    });

    layerEls.forEach((el) => {
      const dy = parseFloat(el.dataset.dy || '0');
      const ds = parseFloat(el.dataset.ds || '1');
      tl.from(
        el,
        {
          y: () => dy * stack.clientHeight,
          scale: ds,
          rotateX: 0,
          duration: 0.7,
          ease: 'power2.inOut',
        },
        0
      );
      /* 攤開後的微透視傾斜,給層一點「擺在空間裡」的角度 */
      tl.to(el, { rotateX: 7, duration: 0.7, ease: 'power2.inOut' }, 0);
    });

    tl.to(heroCopy, { opacity: 0, y: -28, duration: 0.16, ease: 'none' }, 0);
    labelEls.forEach((el, i) => {
      tl.to(el, { opacity: 1, duration: 0.07, ease: 'none' }, 0.42 + i * 0.07);
    });

    gsap.fromTo(
      '#realFigure',
      { clipPath: 'inset(100% 0 0 0)' },
      {
        clipPath: 'inset(0% 0 0 0)',
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: '#realFigure', start: 'top 78%', once: true },
      }
    );
  }
</script>
</body>
</html>
