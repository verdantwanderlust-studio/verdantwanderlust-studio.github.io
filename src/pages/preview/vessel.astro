---
/* /preview/vessel — 生態瓶剖面 3D 原型(throwaway 實驗頁)
   概念:植物圖鑑式的 exploded view。捲動把一座生態瓶逐層拆開,
   每層出現名稱與工法說明,最後接回實物照片。
   技術:vanilla Three.js + GSAP ScrollTrigger(D16:GSAP 主、不用 r3f)。
   注意:本頁刻意不掛 PreviewLayout(深綠暗色,與標本櫃米白互斥),
   自帶完整 head;與 D18 的 3D 禁令衝突一事由 Jason 拍板,僅限 preview 區。 */
import { Image } from 'astro:assets';
import realPhoto from '~/assets/portfolio/01-terrarium-vw.jpg';
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>瓶中森林的剖面 — 景觀丸藝 / Verdant Wanderlust</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Serif+TC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
  />
</head>
<body>

  <!-- 1 · 3D 剖面舞台(pin + scrub) -->
  <section class="stage" id="stage">
    <canvas id="scene" aria-hidden="true"></canvas>

    <header class="hero-copy" id="heroCopy">
      <p class="kicker">景觀丸藝 · Verdant Wanderlust</p>
      <h1>瓶中森林的剖面</h1>
      <p class="lede">排水、淨化、扎根、覆地、定景、生長。六層工法,把一段森林封進玻璃裡。</p>
    </header>

    <div class="labels" id="labels" aria-hidden="true">
      <!-- 由 JS 依 3D 投影定位;內容鏡射至下方 noscript / sr-only 清單 -->
    </div>

    <ol class="sr-layers">
      <li>排水層 Drainage:發泡煉石架空積水,根系不泡爛。</li>
      <li>活性炭 Charcoal:過濾水氣,壓住瓶裡的雜菌與味道。</li>
      <li>介質層 Substrate:赤玉土為主的混合介質,植物在這裡扎根。</li>
      <li>苔蘚層 Moss:白髮苔鋪成地表,鎖住瓶中的濕度。</li>
      <li>石組 Stones:定下山與岸的位置,地景的骨架。</li>
      <li>主植 Planting:蕨與觀葉,瓶中森林的最上層。</li>
    </ol>
  </section>

  <!-- 2 · 實物 -->
  <section class="real">
    <div class="real-inner">
      <figure class="real-figure" id="realFigure">
        <Image src={realPhoto} alt="景觀丸藝的生態瓶實物" width={1400} densities={[1, 2]} class="real-img" />
      </figure>
      <div class="real-text">
        <h2>合起來,它是這樣活著</h2>
        <p>
          每一座生態瓶都照這套層次組成。封瓶之後,光從上方進來,
          水在玻璃內壁往返,苔蘚慢慢把地表長滿,瓶子自己循環。
        </p>
        <p>
          作品交付後我們持續提供養護建議,陪它跟你一起過日子。
        </p>
      </div>
    </div>
  </section>

  <!-- 3 · 去處 -->
  <section class="next">
    <a class="next-link" href="/preview/portfolio">
      <span class="zh">看作品集</span>
      <span class="en">Portfolio</span>
    </a>
    <a class="next-link" href="/preview/courses">
      <span class="zh">工作坊報名</span>
      <span class="en">Workshop</span>
    </a>
  </section>

  <footer class="foot">
    <a href="/preview/">回草稿首頁</a>
    <a href="/preview/vessel-photo">另一版:實物照片拆解</a>
    <p>© 景觀丸藝 Verdant Wanderlust</p>
  </footer>

<style>
  :global(:root) {
    --v-bg: #10140f;
    --v-bg-deep: #0b0e0a;
    --v-ink: #e8e3d5;
    --v-faint: rgba(232, 227, 213, 0.62);
    --v-hairline: rgba(232, 227, 213, 0.16);
    --v-moss: #8fae84;
    --v-serif-en: 'Cormorant Garamond', serif;
    --v-serif-zh: 'Noto Serif TC', serif;
    --v-mono: 'JetBrains Mono', monospace;
    --v-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  :global(html) { background: var(--v-bg); }
  :global(body) {
    margin: 0;
    background: var(--v-bg);
    color: var(--v-ink);
    font-family: var(--v-serif-zh), var(--v-serif-en), serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }

  /* ---- 舞台 ---- */
  .stage {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
  }
  #scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .hero-copy {
    position: absolute;
    top: clamp(24px, 6vh, 64px);
    left: clamp(20px, 6vw, 88px);
    max-width: 30rem;
    z-index: 2;
    pointer-events: none;
  }
  .kicker {
    font-family: var(--v-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--v-faint);
    margin: 0 0 1.1rem;
  }
  .hero-copy h1 {
    font-family: var(--v-serif-zh);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.2vw, 3.9rem);
    line-height: 1.18;
    letter-spacing: 0.04em;
    margin: 0 0 1.1rem;
  }
  .lede {
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.9;
    color: var(--v-faint);
    margin: 0;
    max-width: 26rem;
  }

  /* ---- 投影標籤 ---- */
  .labels { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  :global(.layer-label) {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(180px, 24vw, 280px);
    opacity: 0;
    will-change: transform, opacity;
  }
  :global(.layer-label .ll-head) {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    margin: 0 0 0.35rem;
  }
  :global(.layer-label .ll-zh) {
    font-family: var(--v-serif-zh);
    font-weight: 500;
    font-size: 1.02rem;
    letter-spacing: 0.06em;
  }
  :global(.layer-label .ll-en) {
    font-family: var(--v-serif-en);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--v-moss);
  }
  :global(.layer-label .ll-desc) {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--v-faint);
  }
  :global(.layer-label.side-r) { text-align: left; border-left: 1px solid var(--v-hairline); padding-left: 14px; }
  :global(.layer-label.side-l) { text-align: right; border-right: 1px solid var(--v-hairline); padding-right: 14px; }

  /* WebGL 不可用時的降級 */
  .stage.no-webgl { min-height: auto; padding: clamp(72px, 12vh, 140px) 0 48px; }
  .stage.no-webgl #scene,
  .stage.no-webgl .labels { display: none; }
  .stage.no-webgl .hero-copy { position: static; padding: 0 clamp(20px, 6vw, 88px); }

  .sr-layers {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- 實物 ---- */
  .real { padding: clamp(96px, 16vh, 180px) clamp(20px, 6vw, 88px); background: var(--v-bg-deep); }
  .real-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }
  .real-figure { margin: 0; }
  :global(.real-img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }
  .real-text h2 {
    font-family: var(--v-serif-zh);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    letter-spacing: 0.05em;
    line-height: 1.4;
    margin: 0 0 1.4rem;
  }
  .real-text p {
    font-size: 0.95rem;
    line-height: 2.05;
    color: var(--v-faint);
    margin: 0 0 1.2rem;
    max-width: 34ch;
  }

  /* ---- 去處 ---- */
  .next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--v-hairline);
  }
  .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: clamp(56px, 10vh, 110px) 24px;
    text-decoration: none;
    color: var(--v-ink);
    transition: background-color 240ms var(--v-ease-out);
  }
  .next-link + .next-link { border-left: 1px solid var(--v-hairline); }
  .next-link .zh {
    font-family: var(--v-serif-zh);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: 0.1em;
  }
  .next-link .en {
    font-family: var(--v-serif-en);
    font-style: italic;
    font-size: 1rem;
    color: var(--v-moss);
  }
  @media (hover: hover) and (pointer: fine) {
    .next-link:hover { background: rgba(232, 227, 213, 0.04); }
  }
  .next-link:active { transform: scale(0.99); }

  /* ---- footer ---- */
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 28px clamp(20px, 6vw, 88px);
    border-top: 1px solid var(--v-hairline);
  }
  .foot a {
    color: var(--v-faint);
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
  }
  .foot a:hover { color: var(--v-ink); }
  .foot p {
    margin: 0;
    font-family: var(--v-serif-en);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--v-faint);
  }

  @media (max-width: 760px) {
    .real-inner { grid-template-columns: 1fr; align-items: start; }
    .next { grid-template-columns: 1fr; }
    .next-link + .next-link { border-left: 0; border-top: 1px solid var(--v-hairline); }
    :global(.layer-label) { width: 150px; }
    :global(.layer-label .ll-desc) { display: none; }
  }
</style>

<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ============ 場景 ============ */
  const canvas = document.getElementById('scene') as HTMLCanvasElement;
  const stage = document.getElementById('stage') as HTMLElement;
  const labelsRoot = document.getElementById('labels') as HTMLElement;
  const heroCopy = document.getElementById('heroCopy') as HTMLElement;

  const main = () => {
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.05;

  const scene = new THREE.Scene();
  scene.fog = new THREE.Fog(0x10140f, 14, 26);

  const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 60);
  camera.position.set(0, 1.1, 7.4);
  camera.lookAt(0, -0.1, 0);

  const pmrem = new THREE.PMREMGenerator(renderer);
  scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

  const key = new THREE.DirectionalLight(0xfff4e0, 2.2);
  key.position.set(3, 5, 4);
  scene.add(key);
  scene.add(new THREE.AmbientLight(0x9fb89a, 0.5));
  const rim = new THREE.DirectionalLight(0x8fae84, 0.8);
  rim.position.set(-4, 2, -3);
  scene.add(rim);

  const vessel = new THREE.Group();
  scene.add(vessel);

  /* ---- 玻璃球 ---- */
  const glassMat = new THREE.MeshPhysicalMaterial({
    transmission: 1,
    thickness: 0.5,
    roughness: 0.06,
    ior: 1.45,
    transparent: true,
    opacity: 1,
    color: 0xffffff,
  });
  const glass = new THREE.Mesh(new THREE.SphereGeometry(1.5, 64, 48), glassMat);
  glass.scale.y = 0.97;
  vessel.add(glass);

  /* ---- 共用材質 ---- */
  const matte = (hex: number, rough = 1) =>
    new THREE.MeshStandardMaterial({ color: hex, roughness: rough, metalness: 0 });

  type Layer = { group: THREE.Group; explodeY: number; side: 1 | -1; zh: string; en: string; desc: string };
  const layers: Layer[] = [];

  const addLayer = (build: (g: THREE.Group) => void, explodeY: number, side: 1 | -1, zh: string, en: string, desc: string) => {
    const g = new THREE.Group();
    build(g);
    vessel.add(g);
    layers.push({ group: g, explodeY, side, zh, en, desc });
  };

  /* L1 排水層:發泡煉石(instanced 小石) */
  addLayer((g) => {
    const geo = new THREE.IcosahedronGeometry(0.085, 0);
    const inst = new THREE.InstancedMesh(geo, matte(0x6e573f, 0.95), 150);
    const m = new THREE.Matrix4();
    for (let i = 0; i < 150; i++) {
      const r = Math.sqrt(Math.random()) * 0.88;
      const a = Math.random() * Math.PI * 2;
      const s = 0.7 + Math.random() * 0.6;
      m.compose(
        new THREE.Vector3(Math.cos(a) * r, -1.16 + Math.random() * 0.14, Math.sin(a) * r),
        new THREE.Quaternion().setFromEuler(new THREE.Euler(Math.random() * 3, Math.random() * 3, Math.random() * 3)),
        new THREE.Vector3(s, s * 0.85, s)
      );
      inst.setMatrixAt(i, m);
    }
    g.add(inst);
  }, -1.95, 1, '排水層', 'Drainage', '發泡煉石架空積水,根系不泡爛。');

  /* L2 活性炭:深色薄碟 */
  addLayer((g) => {
    const disc = new THREE.Mesh(new THREE.CylinderGeometry(0.98, 1.02, 0.07, 48), matte(0x1d1f1b, 0.9));
    disc.position.y = -1.0;
    g.add(disc);
  }, -1.15, -1, '活性炭', 'Charcoal', '過濾水氣,壓住瓶裡的雜菌與味道。');

  /* L3 介質層:赤玉土 */
  addLayer((g) => {
    const soil = new THREE.Mesh(new THREE.CylinderGeometry(1.08, 1.0, 0.24, 48), matte(0x5e4632, 1));
    soil.position.y = -0.84;
    const dome = new THREE.Mesh(new THREE.SphereGeometry(1.06, 32, 16, 0, Math.PI * 2, 0, Math.PI / 2), matte(0x5e4632, 1));
    dome.scale.set(1, 0.18, 1);
    dome.position.y = -0.72;
    g.add(soil, dome);
  }, -0.45, 1, '介質層', 'Substrate', '赤玉土為主的混合介質,植物在這裡扎根。');

  /* L4 苔蘚層:起伏的綠丘 */
  addLayer((g) => {
    const greens = [0x46663c, 0x547449, 0x3c5a34, 0x5d7f51];
    for (let i = 0; i < 9; i++) {
      const r = 0.22 + Math.random() * 0.3;
      const geo = new THREE.SphereGeometry(r, 20, 14);
      const pos = geo.attributes.position;
      for (let v = 0; v < pos.count; v++) {
        const n = 1 + (Math.sin(v * 12.9898 + i * 78.233) * 0.5 + 0.5) * 0.12;
        pos.setXYZ(v, pos.getX(v) * n, pos.getY(v) * n * 0.62, pos.getZ(v) * n);
      }
      geo.computeVertexNormals();
      const mound = new THREE.Mesh(geo, matte(greens[i % greens.length], 1));
      const a = Math.random() * Math.PI * 2;
      const rr = Math.sqrt(Math.random()) * 0.72;
      mound.position.set(Math.cos(a) * rr, -0.6 + Math.random() * 0.05, Math.sin(a) * rr);
      g.add(mound);
    }
  }, 0.35, -1, '苔蘚層', 'Moss', '白髮苔鋪成地表,鎖住瓶中的濕度。');

  /* L5 石組 */
  addLayer((g) => {
    const rockMat = matte(0x7e7d74, 0.95);
    const specs: Array<[number, number, number, number]> = [
      [-0.45, -0.42, 0.15, 0.3],
      [0.2, -0.46, -0.3, 0.22],
      [0.55, -0.5, 0.3, 0.16],
    ];
    for (const [x, y, z, s] of specs) {
      const rock = new THREE.Mesh(new THREE.DodecahedronGeometry(s, 0), rockMat);
      rock.position.set(x, y, z);
      rock.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
      rock.scale.y = 0.78;
      g.add(rock);
    }
  }, 1.15, 1, '石組', 'Stones', '定下山與岸的位置,地景的骨架。');

  /* L6 主植:風格化蕨叢 */
  addLayer((g) => {
    const stemMat = matte(0x3f5a36, 0.9);
    const leafMat = matte(0x55784a, 0.85);
    const fronds = 7;
    for (let i = 0; i < fronds; i++) {
      const a = (i / fronds) * Math.PI * 2 + Math.random() * 0.5;
      const lean = 0.35 + Math.random() * 0.35;
      const h = 0.7 + Math.random() * 0.5;
      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.022, h, 6), stemMat);
      stem.position.set(Math.cos(a) * 0.12, -0.55 + h / 2, Math.sin(a) * 0.12);
      stem.rotation.z = Math.cos(a) * lean * 0.5;
      stem.rotation.x = -Math.sin(a) * lean * 0.5;
      g.add(stem);
      const leaf = new THREE.Mesh(new THREE.SphereGeometry(0.16, 12, 8), leafMat);
      leaf.scale.set(1.6, 0.32, 0.7);
      const tip = new THREE.Vector3(0, h / 2, 0).applyEuler(stem.rotation).add(stem.position);
      leaf.position.copy(tip);
      leaf.rotation.y = a;
      leaf.rotation.z = Math.cos(a) * lean * 0.8;
      g.add(leaf);
    }
  }, 1.95, -1, '主植', 'Planting', '蕨與觀葉,瓶中森林的最上層。');

  /* ---- HTML 標籤 ---- */
  const labelEls = layers.map((l) => {
    const el = document.createElement('div');
    el.className = `layer-label ${l.side === 1 ? 'side-r' : 'side-l'}`;
    el.innerHTML = `<p class="ll-head"><span class="ll-zh">${l.zh}</span><span class="ll-en">${l.en}</span></p><p class="ll-desc">${l.desc}</p>`;
    labelsRoot.appendChild(el);
    return el;
  });

  const anchor = new THREE.Vector3();
  const placeLabels = () => {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    layers.forEach((l, i) => {
      anchor.set(l.side * 1.45, l.group.position.y + layerAnchorY[i], 0);
      vessel.localToWorld(anchor);
      anchor.project(camera);
      const px = (anchor.x * 0.5 + 0.5) * w;
      const py = (-anchor.y * 0.5 + 0.5) * h;
      const el = labelEls[i];
      if (l.side === 1) {
        el.style.transform = `translate(${px + 12}px, ${py - 14}px)`;
      } else {
        el.style.transform = `translate(${px - 12 - el.offsetWidth}px, ${py - 14}px)`;
      }
    });
  };
  /* 各層在自身座標系的標示高度(組裝狀態下的內容中心) */
  const layerAnchorY = [-1.12, -1.0, -0.78, -0.5, -0.42, 0.1];

  /* ============ 動畫編排 ============ */
  const exploded = { p: 0 }; // 0 = 組裝, 1 = 拆解

  const applyExplode = () => {
    const p = exploded.p;
    layers.forEach((l) => {
      l.group.position.y = l.explodeY * p;
    });
    glass.position.y = 3.1 * p;
    glassMat.opacity = 1 - 0.85 * p;
    camera.position.z = 7.4 + 4.2 * p;
    camera.position.y = 1.1 - 1.0 * p;
    camera.lookAt(0, -0.1 + 0.45 * p, 0);
  };

  const resize = () => {
    const w = stage.clientWidth;
    const h = stage.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  };
  resize();
  window.addEventListener('resize', () => {
    resize();
    if (reduced) renderOnce();
  });

  const renderOnce = () => {
    applyExplode();
    renderer.render(scene, camera);
    placeLabels();
  };

  if (reduced) {
    /* 靜態:直接呈現拆解完成圖,標籤全顯示 */
    exploded.p = 1;
    labelEls.forEach((el) => (el.style.opacity = '1'));
    renderOnce();
  } else {
    /* pin + scrub:捲動驅動拆解 */
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: stage,
        start: 'top top',
        end: '+=320%',
        pin: true,
        scrub: 0.6,
        invalidateOnRefresh: true,
      },
    });

    tl.to(heroCopy, { opacity: 0, y: -28, duration: 0.12, ease: 'none' }, 0);
    tl.to(vessel.rotation, { y: 0.5, duration: 1, ease: 'power1.inOut' }, 0);
    tl.to(exploded, { p: 1, duration: 0.62, ease: 'power2.inOut', onUpdate: applyExplode }, 0.14);
    labelEls.forEach((el, i) => {
      tl.to(el, { opacity: 1, duration: 0.06, ease: 'none' }, 0.3 + i * 0.075);
    });

    /* 實物照片:clip-path 由下而上揭示(進場一次) */
    gsap.fromTo(
      '#realFigure',
      { clipPath: 'inset(100% 0 0 0)' },
      {
        clipPath: 'inset(0% 0 0 0)',
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: '#realFigure', start: 'top 78%', once: true },
      }
    );

    let idle = 0;
    const tick = (t: number) => {
      idle = t * 0.0001;
      vessel.rotation.y += Math.sin(idle) * 0.0002; /* 極慢的呼吸感 */
      renderer.render(scene, camera);
      placeLabels();
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  };

  try {
    main();
  } catch {
    /* WebGL 不可用:收合 3D 舞台,文字直接接實物照片 */
    stage.classList.add('no-webgl');
  }
</script>
</body>
</html>
