---
import Base from '~/layouts/Base.astro';
import MossHero from '~/components/MossHero.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';

const { data } = await getEntry('pages', 'home');
const marqueeImgs = data.marquee ?? [];
const featuredImgs = data.featured ?? [];

const entries = [
  {
    href: '/portfolio',
    zh: '作品集',
    en: 'Portfolio',
    desc: '近年生態瓶與微景觀紀錄',
    hasMarquee: true,
  },
  {
    href: '/courses',
    zh: '工作坊',
    en: 'Workshop',
    desc: '苔蘚生態瓶手作課程',
    hasMarquee: false,
  },
  {
    href: '/contact?type=biz',
    zh: '商業合作',
    en: 'Collaborations',
    desc: '設計案、品牌合作、空間規劃',
    hasMarquee: false,
  },
];
---
<Base
  title="景觀丸藝 / Verdant Wanderlust"
  description="玻璃裡的微縮地景 —— 苔蘚生態瓶與微景觀工作室。"
>
  <!-- Hero:苔蘚樹枝互動主視覺(客製,D18 已核准的破例 · 2026-07-17)
       h1「將山林,收藏進日常」由 MossHero 自身持有,沿用原 .about-band 的同一句 -->
  <MossHero />

  <!-- 三大入口卡片 -->
  <section class="entries">
    <div class="entries-wrap">
      <ul class="entry-grid">
        {entries.map(e => (
          <li>
            <a
              href={e.href}
              class="entry"
              target="_blank"
              rel="noopener"
            >
              <div class="thumb">
                {e.hasMarquee ? (
                  <div class="marquee" aria-hidden="true">
                    <div class="marquee-track">
                      {[...marqueeImgs, ...marqueeImgs].map((p, i) => (
                        <span class="m-tile">
                          <Image
                            src={p.src}
                            alt={p.alt}
                            width={160}
                            height={160}
                            densities={[1, 2]}
                            loading={i < 6 ? 'eager' : 'lazy'}
                            class="m-img"
                          />
                        </span>
                      ))}
                    </div>
                  </div>
                ) : (
                  <span class="placeholder" aria-hidden="true">{e.zh.slice(0,1)}</span>
                )}
              </div>
              <h3 class="entry-title">
                <span class="zh">{e.zh}</span>
                <span class="en">{e.en}</span>
              </h3>
              <p class="entry-desc">{e.desc}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="featured">
    <div class="featured-wrap">
      <p class="kicker">FEATURED</p>
      <div class="carousel">
        <div class="slides">
          {featuredImgs.map((p, i) => (
            <div class={`slide ${i === 0 ? 'active' : ''}`} data-i={i + 1}>
              <Image
                src={p.src}
                alt={p.alt}
                width={1400}
                densities={[1, 2]}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="featured-img"
              />
            </div>
          ))}
        </div>
        <div class="dots">
          {featuredImgs.map((_, i) => (
            <button class={`dot ${i === 0 ? 'active' : ''}`} aria-label={`第 ${i + 1} 張`} data-i={i + 1}></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bottom-cta">
    <div class="column cta-grid">
      <a href="/about" class="cta">
        <span class="cta-kick">關於</span>
        <span class="cta-t">About</span>
      </a>
      <a href="/contact" class="cta">
        <span class="cta-kick">聯繫</span>
        <span class="cta-t">Contact Us</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* Hero 樣式由 MossHero.astro 自帶(scoped),此處不再有 .about-band */

  /* ============ 三大入口卡(滿版 · 直角) ============ */
  .entries { padding: var(--s-24) 0; }
  .entries-wrap {
    width: 100%;
    padding: 0 var(--s-6);
    box-sizing: border-box;
  }
  .entry-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-8);
  }
  .entry {
    display: block;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 0;
    padding: var(--s-6);
    background: var(--surface);
    color: var(--ink);
    transition: border-color var(--dur-micro) var(--ease),
                transform var(--dur-enter) var(--ease);
  }
  .entry:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .thumb {
    aspect-ratio: 1 / 1;
    background: var(--surface-alt);
    border-radius: 0;
    overflow: hidden;
    margin-bottom: var(--s-4);
    display: flex; align-items: center; justify-content: center;
  }
  .placeholder {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.5rem;
    color: var(--border-strong);
  }
  .entry-title {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin: 0 0 var(--s-2) 0;
  }
  .entry-title .zh {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .entry-title .en {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--subtle);
  }
  .entry-desc {
    margin: 0;
    color: var(--muted);
    font-size: var(--t-sm);
  }

  /* ============ Marquee ============ */
  .marquee {
    width: 100%; height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .marquee-track {
    display: flex;
    gap: var(--s-3);
    padding: 0 var(--s-3);
    animation: marquee-scroll 60s linear infinite;
    will-change: transform;
  }
  .entry:hover .marquee-track { animation-play-state: paused; }
  .m-tile {
    flex: 0 0 80px;
    height: 80px;
    background: var(--border);
    border-radius: 0;
    overflow: hidden;
    display: block;
  }
  .m-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }

  /* ============ 中段 carousel(滿版) ============ */
  .featured { padding: var(--s-16) 0; border-top: 1px solid var(--border); }
  .featured-wrap {
    width: 100%;
    padding: 0 var(--s-6);
    box-sizing: border-box;
  }
  .carousel {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: var(--s-6);
    background: var(--surface);
  }
  .slides {
    position: relative;
    margin-bottom: var(--s-6);
    border-radius: var(--r-sm);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface-alt);
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-enter) var(--ease);
  }
  .slide.active { opacity: 1; }
  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dots {
    display: flex; gap: var(--s-2); justify-content: center;
  }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--border-strong);
    border: none;
    cursor: pointer;
    transition: background var(--dur-micro) var(--ease),
                transform var(--dur-micro) var(--ease);
  }
  .dot.active { background: var(--accent); transform: scale(1.3); }
  .dot:hover { background: var(--accent); }

  /* ============ Bottom CTA ============ */
  .bottom-cta { padding: var(--s-12) 0 var(--s-16); border-top: 1px solid var(--border); }
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--s-12) var(--s-6);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink);
    transition: background var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease);
  }
  .cta:hover {
    background: var(--accent-weak);
    border-color: var(--accent);
  }
  .cta-kick {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: var(--s-2);
  }
  .cta-t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-xl);
    letter-spacing: var(--track-tight);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .entry-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .cta-grid { grid-template-columns: 1fr; }
    .about-band { padding: var(--s-16) 0; }
    .band-inner { max-width: 100%; transform: translateY(-6vh); }
    .about-band h1 { font-size: 28px; white-space: normal; }
  }
</style>
