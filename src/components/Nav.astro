---
import { Image } from 'astro:assets';
import logoMark from '~/assets/logo/wanderlust-mark.png';

const pathname = Astro.url.pathname;

const links = [
  { href: '/about',     zh: '關於',   external: false },
  { href: '/portfolio', zh: '作品集', external: false },
  { href: '/courses',   zh: '課程',   external: false },
  { href: 'https://www.pinkoi.com/store/verdant-wanderlust', zh: '購物', external: true },
  { href: '/contact',   zh: '聯繫',   external: false },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const socials = {
  facebook:  'https://www.facebook.com/p/%E6%99%AF%E8%A7%80%E4%B8%B8%E8%97%9D-61575759762668/',
  instagram: 'https://www.instagram.com/verdant_wanderlust_tw/',
};
---
<nav class="top">
  <div class="column wrap">
    <a class="brand" href="/" transition:name="brand-mark" aria-label="景觀丸藝 首頁">
      <Image
        class="mark-img"
        src={logoMark}
        alt="景觀丸藝"
        height={60}
        loading="eager"
        densities={[1, 2]}
      />
    </a>

    <div class="socials" aria-label="社群連結">
      <a href={socials.facebook} target="_blank" rel="noopener" aria-label="Facebook">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href={socials.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
      </a>
    </div>

    <ul class="links">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            class:list={[{ active: !l.external && isActive(l.href) }]}
            {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {l.zh}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .wrap {
    padding: 14px var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    border: none;
    color: var(--ink);
    margin-right: var(--s-2);
  }
  .brand:hover { border: none; }
  .mark-img {
    height: 60px;
    width: auto;
    display: block;
    filter: invert(1);
  }

  .socials {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    padding-left: var(--s-3);
    border-left: 1px solid var(--border);
    margin-right: auto;
  }
  .socials a {
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    color: var(--muted);
    border-radius: var(--r-sm);
    border: none;
    transition: color var(--dur-micro) var(--ease), background var(--dur-micro) var(--ease);
  }
  .socials a:hover {
    color: var(--accent);
    background: var(--accent-weak);
    border: none;
  }

  .links {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    gap: var(--s-6);
  }
  .links a {
    display: flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--muted);
    border-bottom: none;
    transition: color var(--dur-micro) var(--ease);
  }
  .links a:hover { color: var(--ink); }
  .links a.active { color: var(--ink); }

  @media (max-width: 768px) {
    .wrap { flex-wrap: wrap; gap: var(--s-3); }
    .socials { margin-right: 0; }
    .links { gap: var(--s-3); width: 100%; justify-content: space-between; }
    .mark-img { height: 44px; }
  }
</style>
