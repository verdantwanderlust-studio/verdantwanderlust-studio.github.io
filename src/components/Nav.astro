---
import { Image } from 'astro:assets';
import logoMark from '~/assets/logo/wanderlust-mark.png';

const pathname = Astro.url.pathname;

const links = [
  { href: '/about',     zh: '關於',   external: false },
  { href: '/portfolio', zh: '作品集', external: false },
  { href: '/courses',   zh: '課程',   external: false },
  { href: 'https://www.pinkoi.com/store/verdant-wanderlust', zh: '購物', external: true },
  { href: '/contact',   zh: '聯繫',   external: false },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<nav class="top">
  <div class="wrap">
    <a class="brand" href="/" transition:name="brand-mark" aria-label="景觀丸藝 首頁">
      <Image
        class="mark-img"
        src={logoMark}
        alt="景觀丸藝"
        height={64}
        loading="eager"
        densities={[1, 2]}
      />
    </a>

    <ul class="links">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            class:list={[{ active: !l.external && isActive(l.href) }]}
            {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {l.zh}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .wrap {
    width: 100%;
    padding: 0 var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    border: none;
    color: var(--ink);
    margin-right: var(--s-2);
  }
  .brand:hover { border: none; }
  .mark-img {
    height: 64px;
    width: auto;
    display: block;
  }

  .links {
    list-style: none;
    margin: 0 0 0 auto; padding: 0;
    display: flex;
    gap: 33px;
  }
  .links a {
    display: flex;
    align-items: center;
    font-family: 'Montserrat', 'Noto Serif TC', var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: #3a4914;
    border-bottom: none;
    transition: color var(--dur-micro) var(--ease);
  }
  .links a:hover { color: #3a4914; opacity: 0.7; }
  .links a.active { color: #3a4914; }

  @media (max-width: 768px) {
    .wrap { flex-wrap: wrap; gap: var(--s-3); }
    .links { margin-left: 0; gap: var(--s-3); width: 100%; justify-content: space-between; }
    .mark-img { height: 48px; }
  }
</style>
